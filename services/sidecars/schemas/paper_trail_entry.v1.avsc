{
  "type": "record",
  "name": "PaperTrailEntry",
  "namespace": "xf.paper_trail",
  "doc": "Canonical Avro shape for a PaperTrailEntry deferral event. Versioned subject: paper_trail_entry.v1.",
  "fields": [
    {"name": "id", "type": "long"},
    {"name": "category", "type": "string"},
    {"name": "severity", "type": "string", "default": "medium"},
    {"name": "title", "type": "string"},
    {"name": "abstract", "type": "string", "doc": "BDD-shaped Given/When/Then, <= 1200 words."},
    {"name": "status", "type": "string", "default": "open"},
    {"name": "deferred_by", "type": "string"},
    {"name": "deferred_at_unix", "type": "long", "default": 0},
    {"name": "affected_files", "type": {"type": "array", "items": "string"}, "default": []},
    {"name": "resolution_lessons", "type": ["null", "string"], "default": null}
  ]
}
