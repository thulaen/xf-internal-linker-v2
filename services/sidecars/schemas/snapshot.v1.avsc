{
  "type": "record",
  "name": "Snapshot",
  "namespace": "xf.snapshotd",
  "doc": "Canonical Avro shape for a snapshotd evidence row attached to an AutoIssue. Versioned subject: snapshot.v1.",
  "fields": [
    {"name": "id", "type": "string", "doc": "Snapshot UUID."},
    {"name": "issue_id", "type": "long"},
    {"name": "kind", "type": "string"},
    {"name": "category", "type": ["null", "string"], "default": null},
    {"name": "severity", "type": "string", "default": "medium"},
    {"name": "created_at_unix", "type": "long", "default": 0},
    {"name": "pinned", "type": "boolean", "default": false},
    {"name": "payload_ref", "type": ["null", "string"], "default": null, "doc": "Parquet file path relative to the snapshotd storage root."}
  ]
}
