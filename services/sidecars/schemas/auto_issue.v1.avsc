{
  "type": "record",
  "name": "AutoIssue",
  "namespace": "xf.auto_issues",
  "doc": "Canonical Avro shape for an AutoIssue event published through streamd and stored as snapshotd evidence. Versioned subject: auto_issue.v1.",
  "fields": [
    {"name": "id", "type": "long", "doc": "AutoIssue primary key."},
    {"name": "source", "type": "string", "doc": "Observability source: loki, pyroscope, glitchtip, tempo, vmalert, sonarqube, gwp_asan, perfetto, agent, ..."},
    {"name": "external_id", "type": ["null", "string"], "default": null},
    {"name": "title", "type": "string"},
    {"name": "severity", "type": "string", "default": "medium"},
    {"name": "status", "type": "string", "default": "open"},
    {"name": "priority_score", "type": "double", "default": 0.0},
    {"name": "occurrence_count", "type": "int", "default": 1},
    {"name": "first_seen_unix", "type": "long", "default": 0},
    {"name": "last_seen_unix", "type": "long", "default": 0},
    {"name": "lessons_learned", "type": ["null", "string"], "default": null}
  ]
}
