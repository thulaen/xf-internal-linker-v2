# Super-Linter env file — Phase 5 of the test-hardening plan.
#
# Super-Linter (github/super-linter) runs ~50 different linters in one
# action. We deliberately turn OFF the linters we already run as their
# own dedicated CI jobs (Ruff, ESLint, Stylelint) and turn ON the ones
# we don't (Hadolint for Dockerfile, GitHub Actions YAML, Markdown,
# Bash, generic YAML).
#
# Why split this way: Super-Linter pins its own versions of every tool
# it bundles. Letting it also run Ruff would mean we have two different
# Ruff versions checking the same code in CI — confusing for failures.
# Reserving Super-Linter for the gaps gets us coverage of areas we
# don't currently lint, without duplicating work.

# ── Validators we ENABLE ─────────────────────────────────────────
VALIDATE_BASH=true
VALIDATE_BASH_EXEC=true
VALIDATE_DOCKERFILE_HADOLINT=true
VALIDATE_GITHUB_ACTIONS=true
VALIDATE_MARKDOWN=true
VALIDATE_YAML=true
VALIDATE_JSON=true
VALIDATE_GITLEAKS=true

# ── Validators we DISABLE (run as their own jobs) ────────────────
VALIDATE_PYTHON_RUFF=false
VALIDATE_PYTHON_BLACK=false
VALIDATE_PYTHON_FLAKE8=false
VALIDATE_PYTHON_PYLINT=false
VALIDATE_PYTHON_ISORT=false
VALIDATE_PYTHON_MYPY=false
VALIDATE_TYPESCRIPT_ES=false
VALIDATE_TYPESCRIPT_STANDARD=false
VALIDATE_JAVASCRIPT_ES=false
VALIDATE_JAVASCRIPT_STANDARD=false
VALIDATE_CSS=false
VALIDATE_HTML=false

# ── Exclusion patterns ───────────────────────────────────────────
# Skip generated / vendored / build directories.
FILTER_REGEX_EXCLUDE=(vendor|node_modules|\.venv|build_|build|coverage-html|coverage|reports|migrations|extensions/build_tests)/

# Only lint changed files in PRs (full sweep on push to master).
VALIDATE_ALL_CODEBASE=false

# Output formatter — produces a SARIF file the Phase 6 lint-error
# AutoIssue picker can read.
CREATE_LOG_FILE=true
LOG_LEVEL=ERROR
LOG_FILE=super-linter.log
SARIF_REPORTER=true
