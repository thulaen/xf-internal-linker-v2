# Single self-contained frontend image for the k3s cluster.
#
# Plain English: the docker-compose setup builds the Angular bundle in a
# one-shot container, drops it into a shared Docker volume, and a SEPARATE nginx
# serves it. k3s/containerd has no Docker volumes, so that split does not work
# here. This image does both jobs itself: stage 1 compiles the production
# Angular bundle, stage 2 is a normal nginx that has the bundle baked in and
# proxies /api + /ws to the in-cluster backend Service. One image, no volumes.
#
# Staging note: serves plain HTTP on port 80 (no TLS). The production
# nginx.prod.conf forces HTTPS + HSTS + rate limits; TLS is a later slice once a
# real domain + cert exist. For the staged rehearsal HTTP is enough.
FROM node:22-slim AS build
WORKDIR /app
ENV NODE_OPTIONS=--max-old-space-size=2560
# Install deps first for layer caching (matches Dockerfile.prod's flag).
COPY package.json package-lock.json* ./
RUN npm install --legacy-peer-deps --no-audit --no-fund
COPY . .
RUN npx ng build --configuration=production

FROM nginx:1.30-alpine
# Angular 17+ emits the browser bundle under <outputPath>/browser/.
COPY --from=build /app/dist/xf-internal-linker-frontend/browser/ /usr/share/nginx/html/
COPY nginx-k8s.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
