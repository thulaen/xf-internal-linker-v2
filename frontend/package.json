{
  "name": "xf-internal-linker-frontend",
  "version": "2.0.0",
  "description": "XF Internal Linker V2 - Angular 20 frontend",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200 --poll 1000",
    "build": "ng build",
    "build:prod": "ng build --configuration=production",
    "watch": "ng build --watch --configuration=development",
    "test": "ng test",
    "test:ci": "node --max-old-space-size=4096 ./node_modules/@angular/cli/bin/ng test --no-watch",
    "test:ci:docker": "node --max-old-space-size=768 ./node_modules/@angular/cli/bin/ng test --no-watch",
    "test:mutation": "stryker run",
    "lint": "ng lint",
    "lint:scss": "stylelint \"src/**/*.scss\"",
    "ui:test": "playwright test",
    "ui:test:a11y": "playwright test tests/a11y.spec.ts",
    "ui:test:headed": "playwright test --headed",
    "ui:test:debug": "playwright test --debug",
    "ui:test:live": "set PLAYWRIGHT_LIVE=1&& set PLAYWRIGHT_NO_WEBSERVER=1&& playwright test tests/live",
    "ui:test:live:headed": "set PLAYWRIGHT_LIVE=1&& set PLAYWRIGHT_NO_WEBSERVER=1&& playwright test tests/live --headed",
    "ui:snap": "playwright test tests/capture/page-snapshot.spec.ts --workers=1",
    "ui:snap:live": "set PLAYWRIGHT_LIVE=1&& set PLAYWRIGHT_NO_WEBSERVER=1&& playwright test tests/capture/page-snapshot.spec.ts --workers=1",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
    "generate:api": "openapi-typescript ../backend/schema.yml -o src/app/api/schema.d.ts",
    "analyze": "ng build --configuration=production --source-map && source-map-explorer \"dist/xf-internal-linker-frontend/browser/*.js\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.17",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/localize": "^21.2.17",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.17",
    "@angular/platform-browser-dynamic": "^21.2.17",
    "@angular/router": "^21.2.17",
    "@angular/service-worker": "^21.2.17",
    "@grafana/faro-web-sdk": "^1.13.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-zone": "^1.30.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/instrumentation": "^0.57.0",
    "@opentelemetry/instrumentation-fetch": "^0.57.0",
    "@opentelemetry/instrumentation-xml-http-request": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-trace-web": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@sentry/angular": "^10.57.0",
    "echarts": "^5.5.1",
    "material-icons": "^1.13.14",
    "monaco-editor": "^0.55.1",
    "ngx-monaco-editor-v2": "^21.1.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.15",
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/cli": "^21.2.15",
    "@angular/compiler-cli": "^21.2.17",
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^10.0.1",
    "@pact-foundation/pact": "^16.4.0",
    "@playwright/test": "^1.54.2",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@testing-library/angular": "^19.4.1",
    "@testing-library/jest-dom": "^6.4.6",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.1.1",
    "angular-eslint": "^21.4.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.14.0",
    "eslint-plugin-boundaries": "^6.0.2",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.4.0",
    "postcss": "^8.5.15",
    "prettier": "^3.3.3",
    "source-map-explorer": "^2.5.3",
    "stylelint": "^17.9.1",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^3.1.1",
    "zone.js": "~0.15.0"
  },
  "overrides": {
    "webpack-dev-server": "5.2.4",
    "ws": "8.20.1"
  }
}
