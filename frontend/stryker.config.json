{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "npm run test:ci -- --include $STRYKER_TEST_INCLUDES"
  },
  "mutate": [
    "src/app/**/*.component.ts",
    "src/app/**/*.service.ts",
    "!src/app/**/*.spec.ts",
    "!src/app/**/*.stories.ts"
  ],
  "concurrency": 4,
  "timeoutMS": 120000,
  "coverageAnalysis": "off",
  "reporters": ["progress", "html", "json", "clear-text"],
  "htmlReporter": { "fileName": "reports/stryker.html" },
  "jsonReporter": { "fileName": "reports/stryker.json" },
  "thresholds": {
    "high": 95,
    "low": 95,
    "break": 95
  }
}
