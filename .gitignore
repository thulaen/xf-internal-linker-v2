# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Slice 1.5 — Go binaries built outside the Docker multi-stage scratch image.
# Local `go build` runs land binaries next to go.mod; they should not be
# committed. The Docker image is the canonical artefact.
/services/*/cmd/*/__debug_bin*
/services/*/streamd
/services/*/streamd-healthcheck
/services/streamd/report.json
*.egg-info/
dist/
build/
*.egg

# Virtual environment
venv/
.venv/
env/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
backend/test.sqlite3
backend/test.sqlite3-journal
media/

# Backend data (runtime artifacts)
backend/data/
data/

# Group L #91 — local database backups created by
# `apps.core.services.backups`. Files inside should NEVER be
# committed: they are full Postgres dumps and may contain operator
# secrets, embedding vectors, GA4 / GSC data, and other sensitive
# state.
backups/
backend/backups/

# Environment variables
.env
.env.local
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
# Gemini CLI / Antigravity local MCP config (per-developer, not shared)
.gemini/

