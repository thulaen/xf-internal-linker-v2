env/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
backend/test.sqlite3
backend/test.sqlite3-journal
media/

# Backend data (runtime artifacts)
backend/data/
data/

# Group L #91 — local database backups created by
# `apps.core.services.backups`. Files inside should NEVER be
# committed: they are full Postgres dumps and may contain operator
# secrets, embedding vectors, GA4 / GSC data, and other sensitive
# state.
backups/
backend/backups/

# Environment variables
.env
.env.local
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Node.js / Angular
node_modules/
frontend/dist/
frontend/.angular/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/

# Docker
docker-compose.override.yml
tmp/docker-config/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Google API credentials (NEVER commit these)
*credentials*.json
*client_secret*.json
*token*.json
*service_account*.json

# Embedding cache files
*.npy

# PostgreSQL data
pgdata/

# Redis data
redis-data/

