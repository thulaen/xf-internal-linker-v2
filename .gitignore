frontend/.angular/
frontend/out-tsc/

# Backend static files (build artifacts)
backend/static/

# Rust build artefacts — never commit these; the compiled wheel is the deliverable
rust/target/
rust/mutants.out/
rust/mutants.out.old/
rust/**/.mutmut-cache

# Session scratch files — created by the commit-gauntlet helpers; junk, never commit
.slice4*.json
.slice4*.txt
.slice4*.py
.cov.json

# Data dumps and binary assets that do not belong in git
backend/scripts/autoissues_dump.json
Live-Ranking-Weights.xlsx
*.bak-build*.html
# Ad-hoc one-off ruff-loop fix scripts (created per session, not for commit)
backend/fix_ruff*.py
.claude/

# Cloudflare Tunnel portable binary
tools/cloudflared.exe

# C++ benchmark artifacts
backend/extensions/benchmarks/build/
backend/extensions/benchmarks/results/

# Compiled-language runtime artifacts
*.pyd
*.dll
*.dylib
*.o
*.obj
*.a
*.lib
backend/extensions/*.so
backend/extensions/*.pyd
backend/extensions/build/
backend/extensions/build_*/
backend/extensions/fuzz/build*/
backend/extensions/fuzz/crash-*
backend/extensions/fuzz/oom-*
backend/extensions/fuzz/leak-*
backend/extensions/reports/
build_fuzz*/
cover.out
*.coverprofile

# C++ test build outputs (CMake / Visual Studio / googletest compile products)
# The vendored googletest source under build_tests/_deps/googletest-src/
# stays tracked; only the compiled output is ignored.
backend/extensions/build_tests/CMakeFiles/
backend/extensions/build_tests/Release/
backend/extensions/build_tests/lib/
backend/extensions/build_tests/_deps/googletest-build/
backend/extensions/build_tests/*.cmake
backend/extensions/build_tests/*.vcxproj*
backend/extensions/build_tests/*.sln
backend/extensions/build_tests/CMakeCache.txt
backend/extensions/build_tests/x64/
backend/extensions/build_tests/*.dir/

# `nul` is the Windows null device. Redirecting `> nul` on Git Bash for
# Windows creates a real file instead of discarding output. Pre-empts a
# class of stray artifact that's bitten this repo before.
nul
**/nul

# mkcert localhost TLS certificates � never commit private keys
nginx/certs/*.pem

# Session gate state (written at session start, contains HMAC token)
audit/session_gate_state.json

# Auto-generated mutation-test output directories (mutmut, cargo-mutants, etc.)
**/mutants.out/
**/mutants.out.old/
**/mutants/
backend/mutants/

# Rust build output (speccheck and any future Rust services)
services/speccheck/target/
services/*/target/

# Rust hot-path kernels workspace (rust/) — build output + maturin wheels.
# The Docker-managed build writes target/ to the container's /tmp, but ignore
# these so a stray host `cargo`/`maturin` build never commits artifacts.
rust/target/
rust/**/target/
rust/wheels/
rust/**/*.so
rust/**/*.pyd

# Miscellaneous Go and C++ test/bench artefacts that don't belong in the repo
**/cover.out
**/bench.txt
**/.compile.lock
**/pprof.out
services/*/report.json

# Transcript and audit log artefacts (agent session logs — gitignored, not committed)
audit/resolved_issues_lookup_log.jsonl
audit/*.jsonl

# Accidental / disposable scratch artefacts that have crept into the repo root.
# These are byproducts of tools and malformed commands, never source:
#   nul            — Windows redirect artefact (`> nul` creating a real file)
#   cookies.txt    — curl cookie jar
#   frontend;C     — malformed `--prefix frontend;C:\...` path turned into a dir
#   tmp.txt, patch.diff, *.orig, *.rej — scratch / merge leftovers
#   luacov.stats.out — Lua coverage output
#   test_dry_perf*.py — throwaway perf experiments (real tests live under tests/)
#   findbugs-*.png — local screenshots
#   tmp/           — disposable scratch dir (prompt drafts, sync staging)
/nul
/cookies.txt
/frontend;C
/tmp.txt
/patch.diff
*.orig
*.rej
luacov.stats.out
/test_dry_perf*.py
/findbugs-*.png
/tmp/
# Disposable scratch dirs and intermediate build files anywhere in the tree.
# *.tmp covers protoc/buf intermediates like main.go.tmp and api/gen/*.tmp.
backend/tmp/
**/*.tmp

# Runtime / generated artefacts that must never be tracked (bulk-cleanup pass):
# bandit virtualenv, generated coverage HTML + reports, the cross-agent progress
# tool's runtime state, and autotuner-written cluster params.
.venv-bandit/
reports/
backend/html/
audit/agent_progress_latest.txt
audit/agent_progress_state.json
audit/inter_model/
audit/cluster_tuned_params.json
services/sidecars/sidecars
backend/audit/admin_recovery_log.jsonl
scripts/inter_model_state.sqlite

# Bazel (ADR 0010) — convenience symlinks + outputs, never committed.
/bazel-*
bazel-out/
bazel-bin/
bazel-testlogs/
MODULE.bazel.lock
