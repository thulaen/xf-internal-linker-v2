{
  "builders": {
    "mint": "mint",
    "windows": "desktop-linux",
    "general": "mint"
  },
  "compilation_split": {
    "mint_percent": 100,
    "windows_percent": 0,
    "salt": "xf-internal-linker-v2-build-split-v1"
