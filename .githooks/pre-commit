#!/usr/bin/env bash
# Pre-commit hook
#
# Goal: catch fast-feedback bugs (style, basic lint) before they reach CI.
# Slower checks (full unit tests, type-check) stay in CI — they would make
# every commit feel sluggish locally.
#
# Each lint stage is OPT-IN BY PRESENCE: if the tool isn't installed
# locally, the stage is silently skipped. This way the hook never blocks
# a commit because of a missing dev dependency — CI remains the safety net
# of last resort. When the tool IS present and the lint fails, the commit
# IS blocked (fast feedback).
set -e
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(git rev-parse --show-toplevel)"

# 1. Existing: Gemini-breaking worktreeConfig guard.
"${HOOK_DIR}/_ensure-git-config-clean.sh" || true

# 2. Backend: ruff on staged Python files. Skipped if ruff isn't installed.
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
if [ -n "$STAGED_PY" ] && command -v ruff > /dev/null; then
  echo "→ ruff check (staged Python)"
  ruff check $STAGED_PY
fi

# 3. Frontend: ESLint on staged TS/HTML. Skipped if frontend/node_modules
#    is absent (e.g., contributor hasn't run `npm install` yet).
STAGED_FE=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|html)$' | grep '^frontend/' || true)
if [ -n "$STAGED_FE" ] && [ -d "$REPO_ROOT/frontend/node_modules/eslint" ]; then
  echo "→ ESLint (staged TS/HTML)"
  FE_RELATIVE=$(echo "$STAGED_FE" | sed "s|^frontend/||")
  (cd "$REPO_ROOT/frontend" && npx eslint $FE_RELATIVE)
fi

# 4. Frontend: Stylelint on staged SCSS. Skipped if Stylelint isn't installed
#    (it lands with the Stylelint plan part). Once installed, all staged
#    .scss files are checked against frontend/.stylelintrc.json which
#    enforces the GA4 design rules from CLAUDE.md.
STAGED_SCSS=$(git diff --cached --name-only --diff-filter=ACM | grep '\.scss$' | grep '^frontend/' || true)
if [ -n "$STAGED_SCSS" ] && [ -d "$REPO_ROOT/frontend/node_modules/stylelint" ]; then
  echo "→ Stylelint (staged SCSS)"
  SCSS_RELATIVE=$(echo "$STAGED_SCSS" | sed "s|^frontend/||")
  (cd "$REPO_ROOT/frontend" && npx stylelint $SCSS_RELATIVE)
fi

# 5. No-duplicates invariant on new migrations. Block commits that
#    introduce per-content artefact tables without the
#    (content_hash, signal_version) + supersede + retention pattern
#    from NO-DUPLICATES.md. Skipped if Python isn't on PATH.
STAGED_MIGRATIONS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^backend/.*/migrations/.*\.py$' || true)
if [ -n "$STAGED_MIGRATIONS" ] && command -v python > /dev/null; then
  echo "→ NO-DUPLICATES invariant (staged migrations)"
  python "$HOOK_DIR/check-no-duplicates-invariant.py" $STAGED_MIGRATIONS
fi

# 6. Forbidden patterns from PERFORMANCE-SAFE-DEFAULTS.md (silent excepts,
#    unbounded loops, unbounded iter, unscoped TODOs). Blocks commit on
#    rules 1-4; emits warnings only for rules 5-6 (long functions, missing
#    docstring). Override per-instance with
#       # noqa: forbidden-pattern <rule>  # justification: ...
#    near the violation. Skipped if Python isn't on PATH.
if [ -n "$STAGED_PY" ] && command -v python > /dev/null; then
  echo "→ Forbidden patterns (PERFORMANCE-SAFE-DEFAULTS.md)"
  python "$HOOK_DIR/check-forbidden-patterns.py" $STAGED_PY
fi

# 7. Glossary update rule from GLOSSARY-RULE.md. Blocks commits that
#    introduce new acronyms / project shorthand without a matching row in
#    PLAIN-ENGLISH-RULE.md's table. Skipped if Python isn't on PATH.
STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACM || true)
if [ -n "$STAGED_ALL" ] && command -v python > /dev/null; then
  echo "→ Glossary update rule (GLOSSARY-RULE.md)"
  python "$HOOK_DIR/check-glossary.py" $STAGED_ALL
fi

# 8. Deep-link catalog rule from DEEP-LINKING-CATALOG.md. Blocks commits
#    that add a route without registering it in deep-link-catalog.ts.
#    Tab + dialog gaps are reported as informational warnings only —
#    those don't fail the commit. Only fires when files that could
#    affect the catalog or routes are staged.
STAGED_DEEP_LINK_FILES=$(echo "$STAGED_ALL" | grep -E "frontend/src/app/(app\.routes\.ts|core/routing/deep-link-catalog\.ts|.*\.(html|ts))$" || true)
if [ -n "$STAGED_DEEP_LINK_FILES" ] && command -v python > /dev/null; then
  echo "→ Deep-link catalog rule (DEEP-LINKING-CATALOG.md)"
  python "$REPO_ROOT/scripts/verify_deep_links.py" --quiet
fi

# 9. Default-on rule from DEFAULT-ON-RULE.md. Blocks commits that seed
#    an AppSetting row with an off value (false/0/0.0/off) unless the
#    migration's docstring contains the external-data-gated exemption
#    plus a Reason line. Skipped if Python isn't on PATH.
if [ -n "$STAGED_MIGRATIONS" ] && command -v python > /dev/null; then
  echo "→ Default-on rule (DEFAULT-ON-RULE.md)"
  python "$HOOK_DIR/check-default-on-rule.py" $STAGED_MIGRATIONS
fi

# 10. Registry-read marker enforcement. When AGENT-HANDOFF.md is touched,
#     the new entry MUST contain `[REGISTRY READ: <N> open auto-issues ...
#     — picked: #..., #...]` per the ABSOLUTE rule in CLAUDE.md.
if command -v python > /dev/null; then
  echo "→ Registry-read marker (CLAUDE.md ABSOLUTE rule)"
  python "$HOOK_DIR/check-registry-read.py"
fi
