#!/bin/bash
# Automatically enforce test checks before pushing to repository
# This prevents AI agents and developers from breaking CI with bad commits.

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo "========================================="
echo "Running Pre-push checks (Full verify + prune)"
echo "========================================="

# 1. Auto-generate any missing Django migrations and commit them
echo "=> Checking Django migrations..."
cd "$REPO_ROOT/backend" || exit 1
export DJANGO_SETTINGS_MODULE=config.settings.ci
export DJANGO_SECRET_KEY=ci-fake-secret-key
python manage.py makemigrations
if [ $? -ne 0 ]; then
  echo "[ERROR] makemigrations failed. Push aborted."
  exit 1
fi

# If new migration files were created, auto-commit them
NEW_MIGRATIONS=$(git -C "$REPO_ROOT" status --short -- backend/ | grep -E "^\?\?|^A |^ M" | grep "migrations/")
if [ -n "$NEW_MIGRATIONS" ]; then
  echo "=> New migrations detected — committing automatically..."
  git -C "$REPO_ROOT" add backend/
  git -C "$REPO_ROOT" commit -m "chore(migrations): auto-generate missing migrations [pre-push]"
  if [ $? -ne 0 ]; then
    echo "[ERROR] Failed to commit auto-generated migrations. Push aborted."
    exit 1
  fi
fi

# Confirm no further migrations are needed
python manage.py makemigrations --check --dry-run
if [ $? -ne 0 ]; then
  echo "[ERROR] Migration check failed even after auto-generate. Push aborted."
  exit 1
fi
cd "$REPO_ROOT"

# 2. Full local verification (C++, backend, frontend, plus artifact prune)
echo "=> Running full local verification..."
powershell.exe -ExecutionPolicy Bypass -File "$REPO_ROOT/scripts/verify.ps1"
if [ $? -ne 0 ]; then
  echo "[ERROR] Full local verification failed. Push aborted."
  exit 1
fi

# 3. Docker Compose validation
echo "=> Validating docker-compose.yml..."
cp "$REPO_ROOT/.env.example" "$REPO_ROOT/.env"
docker compose -f "$REPO_ROOT/docker-compose.yml" config > /dev/null
if [ $? -ne 0 ]; then
  echo "[ERROR] docker-compose.yml is invalid. Push aborted."
  exit 1
fi

# 4. Business Logic Checklist reminder
BUSINESS_LOGIC_DIRS=(
  "backend/apps/pipeline"
  "backend/apps/analytics"
  "backend/apps/cooccurrence"
)
STAGED_FILES=$(git diff --cached --name-only 2>/dev/null)
for DIR in "${BUSINESS_LOGIC_DIRS[@]}"; do
  if echo "$STAGED_FILES" | grep -q "^$DIR"; then
    echo ""
    echo "========================================="
    echo "  REMINDER: Business logic files staged."
    echo "  Did you complete docs/BUSINESS-LOGIC-CHECKLIST.md"
    echo "  before writing this code? All 7 sections"
    echo "  (0-6) must be checked or justified."
    echo "========================================="
    echo ""
    break
  fi
done

# Coverage erosion gate (Gap #10 from OBSERVABILITY-GAPS-EXTENSION.md).
# Skips silently when `coverage` isn't installed; fails the push when
# total coverage drops > 2 pp below the baseline at .coverage-baseline.json.
echo "=> Coverage erosion gate"
python "$REPO_ROOT/.githooks/check-coverage-erosion.py"
if [ $? -ne 0 ]; then
  echo "[ERROR] Coverage erosion gate failed. Push aborted."
  exit 1
fi

# Bundle-size regression gate (Gap #11). Skips silently when the prod
# Angular bundle hasn't been built yet; fails the push when main + chunks
# grew > 10 % above the baseline at .bundle-size-baseline.json.
echo "=> Bundle-size regression gate"
python "$REPO_ROOT/.githooks/check-bundle-size.py"
if [ $? -ne 0 ]; then
  echo "[ERROR] Bundle-size regression gate failed. Push aborted."
  exit 1
fi

# ── Phase 3 heavy band: clang-tidy on changed C++ files ──────────
# Opt-in by presence:
#  - skipped when clang-tidy isn't on PATH (CI is the safety net)
#  - skipped when compile_commands.json isn't present (no CMake build yet)
# When both are present, every changed .cpp gets clang-tidy-checked against
# the WarningsAsErrors subset in .clang-tidy. A failing rule blocks the push.
echo "=> Clang-Tidy (changed C++ files)"
UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || echo "origin/master")
CHANGED_CPP=$(git diff --name-only "${UPSTREAM}...HEAD" 2>/dev/null | grep -E '^backend/extensions/.*\.cpp$' | grep -v '/build' || true)
if [ -n "$CHANGED_CPP" ] && command -v clang-tidy > /dev/null 2>&1; then
  COMPDB="$REPO_ROOT/backend/extensions/build/compile_commands.json"
  if [ -f "$COMPDB" ]; then
    for src in $CHANGED_CPP; do
      echo "   clang-tidy $src"
      clang-tidy --quiet -p "$REPO_ROOT/backend/extensions/build" "$REPO_ROOT/$src"
      if [ $? -ne 0 ]; then
        echo "[ERROR] clang-tidy reported a WarningsAsErrors-class issue in $src. Push aborted."
        echo "        See .clang-tidy for the enforced rule list."
        exit 1
      fi
    done
  else
    echo "   SKIPPED — no compile_commands.json at $COMPDB"
    echo "   Run: cmake -B backend/extensions/build -S backend/extensions -DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
  fi
fi

echo "========================================="
echo "All checks passed! Push proceeding..."
echo "========================================="
exit 0
