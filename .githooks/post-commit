#!/usr/bin/env bash
#
# Post-commit Decision Point shim (Session S3 of the TDD-pipeline rule).
#
# Fires automatically after every successful commit. Shells
# `manage.py decision_point --commit <HEAD>` which examines the merged
# diff and files AutoIssue(category='decision_point') rows in six
# buckets: improvements / warnings / problems / missing_spec /
# off_track_test_case / off_track_tdd.
#
# The printed [DECISION POINT: ...] marker is shown to the user so it
# can be pasted into the next session's AGENT-HANDOFF.md entry, where
# `.githooks/check-decision-point.py` will then validate it on the
# NEXT code-changing commit.
#
# This hook NEVER blocks the commit it runs after (the commit already
# succeeded). If the backend stack is offline, it warns to stderr but
# always exits 0 so a broken backend can't undo a clean commit.
#
# Spec: docs/TDD-PIPELINE-RULE.md.

set -u

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root" || exit 0

head_hash="$(git rev-parse HEAD 2>/dev/null || true)"
if [ -z "$head_hash" ]; then
  echo "[decision-point] (no HEAD commit — skipping)" >&2
  exit 0
fi

# Try to run the command via Docker. If anything fails, warn but do
# not block — the commit has already landed.
if ! command -v docker >/dev/null 2>&1; then
  echo "[decision-point] docker not on PATH; skipping Decision Point ritual." >&2
  exit 0
fi

if ! docker compose ps --status running --services 2>/dev/null | grep -q '^backend$'; then
  echo "[decision-point] backend container not running; skipping. Run \`docker compose up -d backend\` then \`docker compose exec -T backend python manage.py decision_point --commit ${head_hash:0:7}\` to back-fill." >&2
  exit 0
fi

docker compose exec -T backend python manage.py decision_point --commit "$head_hash" 2>&1 || \
  echo "[decision-point] command exited non-zero; rerun manually after fixing." >&2

exit 0
